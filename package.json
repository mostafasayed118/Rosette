{
    "name":  "rosette",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "tsc --noEmit \u0026\u0026 eslint .",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "cf:build":  "opennextjs-cloudflare build \u0026\u0026 node scripts/check-worker-size.mjs",
                    "cf:preview":  "opennextjs-cloudflare build \u0026\u0026 opennextjs-cloudflare preview",
                    "cf:deploy":  "opennextjs-cloudflare build \u0026\u0026 node scripts/check-worker-size.mjs \u0026\u0026 opennextjs-cloudflare deploy",
                    "test:e2e":  "vitest run --config vitest.e2e.config.ts tests/e2e/rosette.playwright.test.ts",
                    "test:e2e:stagehand":  "vitest run --config vitest.e2e.config.ts tests/e2e/rosette.e2e.test.ts",
                    "lint:fix":  "eslint . --fix"
                },
