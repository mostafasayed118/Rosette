{
    "name": "rosette",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "tsc --noEmit && eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "analyze": "cross-env ANALYZE=true next build",
        "analyze:server": "cross-env ANALYZE=true BUNDLE_ANALYZE=server next build",
        "cf:build": "opennextjs-cloudflare build && node scripts/check-worker-size.mjs",
        "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "cf:deploy": "opennextjs-cloudflare build && node scripts/check-worker-size.mjs && opennextjs-cloudflare deploy",
        "test:e2e": "vitest run --config vitest.e2e.config.ts tests/e2e/rosette.playwright.test.ts",
        "test:e2e:stagehand": "vitest run --config vitest.e2e.config.ts tests/e2e/rosette.e2e.test.ts",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": "eslint --fix"
    },
    "dependencies": {
        "@sentry/nextjs": "^10.71.0",
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.112.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fuse.js": "^7.5.0",
        "groq-sdk": "^1.5.0",
        "lucide-react": "^1.31.0",
        "motion": "^12.43.0",
        "next": "^16.3.1",
        "next-themes": "^0.4.6",
        "nodemailer": "^9.0.5",
        "radix-ui": "^1.6.7",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "resend": "^6.24.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@browserbasehq/stagehand": "^3.7.2",
        "@eslint/eslintrc": "^3.3.6",
        "@next/bundle-analyzer": "^16.3.3",
        "@opennextjs/cloudflare": "^1.20.2",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "6.8.0",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "24.3.0",
        "@types/nodemailer": "^8.0.1",
        "@types/react": "19.1.10",
        "@types/react-dom": "19.1.7",
        "@vitest/coverage-v8": "^3.2.7",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.2",
        "husky": "^9.1.7",
        "jsdom": "26.1.0",
        "lint-staged": "^17.4.1",
        "playwright": "^1.62.1",
        "tailwindcss": "^4.3.3",
        "typescript": "5.9.2",
        "vitest": "^3.2.6",
        "wrangler": "^4.125.0",
        "zod": "^4.4.3"
    }
}
