DEPLOYMENT_RUNTIME=
PAYMENT_MODE=cod
EMAIL_DELIVERY_MODE=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com

GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# HMAC secret for signed guest email-preference unsubscribe links.
EMAIL_PREFERENCES_SECRET=

# Server-only secret used to hash and encrypt digital gift-card codes.
GIFT_CARD_SECRET=

GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini

WHATSAPP_BUSINESS_NUMBER=

# Public origin used for payment callbacks/redirects when behind a tunnel or
# reverse proxy (e.g. https://app.trycloudflare.com). Falls back to the
# request URL origin when unset.
SITE_URL=

# Shared secret for the notification retry cron endpoint. Any scheduler
# (e.g. GitHub Actions cron, or any scheduler) must send it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Optional retry-job tuning. Positive integers only; defaults are 3 attempts
# and a 15-minute stale-`pending` window.
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_STALE_PENDING_MINUTES=15
