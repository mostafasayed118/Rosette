DEPLOYMENT_RUNTIME=
PAYMENT_MODE=cod
EMAIL_DELIVERY_MODE=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com

GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# HMAC secret for signed guest email-preference unsubscribe links.
EMAIL_PREFERENCES_SECRET=

# Server-only secret used to hash and encrypt digital gift-card codes.
GIFT_CARD_SECRET=

GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini

WHATSAPP_BUSINESS_NUMBER=

# Cloudflare Turnstile (free bot protection). Host: your workers.dev / custom domain.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Web Analytics (free, privacy-first). Beacon token from Web Analytics dashboard.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Resend (free 3k emails/mo). Falls back to Gmail SMTP if unset.
RESEND_API_KEY=
RESEND_FROM=Rosette <hello@rosette.com>

# Public origin used for payment callbacks/redirects when behind a tunnel or
# reverse proxy (e.g. https://app.trycloudflare.com). Falls back to the
# request URL origin when unset.
SITE_URL=

# Shared secret for the notification retry cron endpoint. Any scheduler
# (e.g. GitHub Actions cron, or any scheduler) must send it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Optional distributed rate limiting (Upstash Redis REST API). When both are
# set, rate limits share state across Cloudflare Workers isolates; when unset,
# limits fall back to per-isolate memory (single-client burst protection only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional retry-job tuning. Positive integers only; defaults are 3 attempts
# and a 15-minute stale-`pending` window.
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_STALE_PENDING_MINUTES=15
